; Chasmet Zelda-like RPG - Godot 4.7
config_version=5

[application]
config/name="Les Chroniques de Skypiea"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.055, 0.09, 1)

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true

[physics]
common/enable_pause_aware_picking=true
3d/default_gravity=22.0

[audio]
default_bus_layout="res://default_bus_layout.tres"
